{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/demo/mr-bills/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/demo/mr-bills/(.*\\.[^.]+)$",
      "dest": "/$1"
    },
    {
      "src": "^/demo/mr-bills(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "/(?!.*\\.[^.]+$)",
      "dest": "/index.html"
    }
  ]
}
